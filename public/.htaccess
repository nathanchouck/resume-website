# Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# PDF files: prevent search engine indexing
<FilesMatch "\.pdf$">
  Header set X-Robots-Tag "noindex"
</FilesMatch>

# Long-lived immutable caching for hashed Next.js build assets (/_next/static/**)
# Scoped via SetEnvIf on REQUEST_URI rather than an Apache <If> mod_version
# expression: SetEnvIf is a long-standing, universally supported directive,
# whereas <If> regex ("=~") support on LiteSpeed varies by version/config.
# This keeps the rule simple and predictable while only affecting the
# hashed, content-addressed /_next/static/ path -- nothing else changes TTL.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/_next/static/" IMMUTABLE_ASSET
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET
</IfModule>

# Redirect www to apex domain
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
